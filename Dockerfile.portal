FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /workspace
COPY portal/ /workspace/
RUN mvn -DskipTests clean package

FROM eclipse-temurin:21-jre
WORKDIR /app
COPY --from=build /workspace/target/remote-portal-*.jar /app/app.jar
ENV SERVER_PORT=10000
EXPOSE 10000
ENTRYPOINT ["sh","-c","exec java -Dserver.port=${SERVER_PORT:-10000} -jar /app/app.jar"]
