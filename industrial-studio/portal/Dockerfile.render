# Industrial Control Studio cloud CONFIGURATOR demo — NO OPC/PLC network access.
# Repository root is the Docker build context.
FROM maven:3.9-eclipse-temurin-21 AS build
WORKDIR /source
COPY industrial-studio/portal/pom.xml /source/pom.xml
RUN mvn --batch-mode dependency:go-offline
COPY industrial-studio/portal/src /source/src
RUN mvn --batch-mode -DskipTests package

FROM eclipse-temurin:21-jre-jammy
WORKDIR /app
RUN useradd --create-home --uid 10001 studio
COPY --from=build /source/target/industrial-studio-portal-*.jar /app/studio.jar
RUN chown 10001:10001 /app/studio.jar
USER studio
ENV STUDIO_BIND=0.0.0.0 \
    STUDIO_CLOUD_CONFIG_ONLY=true \
    STUDIO_SOURCE_MODE=SIMULATION \
    PORT=10000 \
    JAVA_TOOL_OPTIONS="-XX:MaxRAMPercentage=65.0 -XX:+ExitOnOutOfMemoryError"
EXPOSE 10000
ENTRYPOINT ["java","-jar","/app/studio.jar"]
