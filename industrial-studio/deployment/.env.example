# COPY to .env.local and set three different, long random values.
# Never commit .env.local; never use these placeholders as passwords.
STUDIO_DB_NAME=industrial_studio
STUDIO_DB_USER=studio
STUDIO_DB_PASSWORD=REPLACE_WITH_RANDOM_32_PLUS_CHARACTER_SECRET
STUDIO_ADMIN_PASSWORD=REPLACE_WITH_SEPARATE_RANDOM_32_PLUS_CHARACTER_SECRET
STUDIO_VIEWER_PASSWORD=REPLACE_WITH_DIFFERENT_RANDOM_32_PLUS_CHARACTER_SECRET
